<config xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
        xmlns='http://www.ehcache.org/v3'
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.7.xsd">

    <!-- Bez persistence direktorijuma -->
    <cache-template name="default">
        <expiry><ttl unit="minutes">30</ttl></expiry>
        <resources>
            <heap>1000</heap>
            <!-- bez <offheap> i bez <disk> -->
        </resources>
    </cache-template>

    <cache alias="com.example.onlybunsbe.model.User" uses-template="default"/>
    <cache alias="com.example.onlybunsbe.model.Post" uses-template="default"/>
    <cache alias="com.example.onlybunsbe.model.Comment" uses-template="default"/>
    <cache alias="com.example.onlybunsbe.model.Location" uses-template="default"/>

    <cache alias="trends.summary" uses-template="default"/>
    <cache alias="trends.topPosts7d" uses-template="default"/>
    <cache alias="trends.topPostsAll" uses-template="default"/>
    <cache alias="trends.topLikers7d" uses-template="default"/>

</config>
